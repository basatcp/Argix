{
  "$comment": "Hero frame sequence. Put approved frames in hero-frames/source (any size, PNG/JPG/WebP), list them here in order, then run `npm run frames`. Times are seconds from the start of the intro. Band edges are multiples of the closed core's outer radius (measured from the first frame).",
  "background": "auto",
  "align": "auto",
  "output": { "lg": 1200, "sm": 640, "quality": 82 },
  "objectRadius": 0.4,
  "feather": [0.43, 0.49],
  "bands": [
    { "name": "core", "to": 0.2 },
    { "name": "inner", "to": 0.43 },
    { "name": "rings", "to": 0.665 },
    { "name": "shell", "to": 1.12 },
    { "name": "orbit" }
  ],
  "ringSpin": { "from": 3.2, "to": 5.7, "degrees": { "inner": 2.4, "rings": -2.4 } },
  "frames": [
    { "id": "closed", "file": "01-closed.png", "at": 0, "glow": 0.18 },
    { "id": "activation", "file": "02-activation.png", "from": 0.8, "at": 1.8, "glow": 0.6, "reveal": "radial", "ease": "sine" },
    { "id": "panels-opening", "file": "03-panels-opening.png", "at": 3.2, "glow": 0.62 },
    { "id": "internal-structure", "file": "04-internal-structure.png", "at": 4.5, "glow": 0.7 },
    { "id": "fully-open", "file": "05-fully-open.png", "at": 5.7, "glow": 0.85 },
    { "id": "service-nodes", "file": "06-service-nodes.png", "at": 6.25, "glow": 0.85, "reveal": "radial" },
    { "id": "orbit-modules", "file": "07-orbit-modules.png", "at": 6.8, "glow": 0.88, "reveal": "radial" },
    { "id": "final", "file": "08-final.png", "at": 8.0, "glow": 0.8, "ease": "out" }
  ]
