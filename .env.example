# Consultation form destination. Copy to .env.local and fill in.
# Everything here ends up in the public bundle: never put API keys or tokens in it.
# CRMs that need a private key (Salesforce, Zoho, HubSpot private apps) belong behind your own API.

# custom | formspree | hubspot
VITE_CONSULTATION_PROVIDER=custom

# custom: your API (receives POST application/json, see src/consultation/submit.ts)
# formspree: https://formspree.io/f/<form id>
VITE_CONSULTATION_ENDPOINT=

# hubspot (public identifiers, not secrets)
VITE_HUBSPOT_PORTAL_ID=
VITE_HUBSPOT_FORM_ID=

# Design previews only: "true" shows the success state without sending anything.
VITE_CONSULTATION_DEMO=false
